<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tech Store — Акційний товар</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="header">
        <h1>Tech Store</h1>
        <p>Технології для твого комфорту</p>
    </header>

    <main>
        <h2>Товар дня</h2>

        <article class="product-card">
            <span class="sale">АКЦІЯ</span>

            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=900&q=85"
                     alt="Бездротові навушники"">
            </div>

            <div class="product-info">
                <p class="category">Аудіотехніка</p>
                <h3>Бездротові навушники</h3>
                <p class="description">Якісний звук, зручна посадка та до 30 годин роботи без підзарядки.</p>
                <div class="price-row">
                    <span class="old-price">4 500 грн</span>
                    <span class="price">3 500 грн</span>
                </div>
                <button class="buy-button" type="button">Купити</button>
            </div>
        </article>
    </main>

    <footer>
        <p>© 2026 Tech Store</p>
    </footer>
</body>
</html>
